# Copy to .env.local and fill in from Supabase → Project Settings → API Keys.

# Public: safe to expose in the browser (access is limited by RLS).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Secret: server only. Bypasses RLS — never prefix with NEXT_PUBLIC_.
# Used by seed scripts (phase 1) and the purge cron (phase 6).
SUPABASE_SECRET_KEY=sb_secret_...
